# VeriAgent backend configuration
# Copy to backend/.env and adjust values. Never commit .env.
# The API loads backend/.env automatically on startup when the file exists
# (same locally and in production). Variables already set in the process
# environment — shell export, systemd EnvironmentFile, container env — take
# precedence over this file. See docs/05-deployment.md.

# --- Core secrets (required for non-dev use) ---
# HMAC secret for ingestion receipts. If unset, a development fallback is used.
VERIAGENT_RECEIPT_SECRET=replace-with-a-long-random-secret

# Admin key for X-VeriAgent-Admin-Key (agent break-glass register, batch/anchor, registration review).
VERIAGENT_ADMIN_API_KEY=replace-with-a-long-random-admin-key

# Optional SQLite path (default: backend/data/veriagent.db)
# VERIAGENT_DB_PATH=data/veriagent.db

# --- Public registration workflow ---
# Master switch for /registration/* routes (false | true)
VERIAGENT_REGISTRATION_ENABLED=true

# Challenge / pending window in minutes (default 15). Pending requests expire when this elapses.
VERIAGENT_REGISTRATION_CHALLENGE_TTL_MINUTES=15

# --- Automatic batching and anchoring ---
# When true, the API process runs a background batch+anchor loop.
VERIAGENT_AUTO_ANCHOR_ENABLED=false
VERIAGENT_AUTO_ANCHOR_INTERVAL_SECONDS=300
VERIAGENT_AUTO_ANCHOR_MIN_EVENTS=1

# --- Blockchain anchoring (required for manual or auto anchor) ---
# Without these, registration and event submit still work; anchoring returns 503.
# VERIAGENT_RPC_URL=https://rpc.dimikog.org/rpc/
# VERIAGENT_CHAIN_ID=424242
# VERIAGENT_ANCHOR_CONTRACT_ADDRESS=0x30546417E83A0C96bf87BEdfEe59De8FBdf1187A
# VERIAGENT_ANCHOR_PRIVATE_KEY=0xYOUR_OWNER_PRIVATE_KEY_NEVER_COMMIT
